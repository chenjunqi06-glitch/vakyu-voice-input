<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleExecutable</key>
	<string>qingjian-macos</string>
	<key>CFBundleIdentifier</key>
	<string>app.qingjian.inputmethod</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Vakyu</string>
	<key>CFBundleDisplayName</key>
	<string>Vakyu</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>Vakyu</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSBackgroundOnly</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- TCC 会将嵌套语音 app 的麦克风请求归属到外层输入法。 -->
	<key>NSMicrophoneUsageDescription</key>
	<string>按住语音快捷键时在本机识别说话；启用跟读时用麦克风判断朗读进度，不上传音频。</string>

	<!-- 当前 IMK 校验使用 <bundle id>.Connection；下划线旧名在 macOS 26 被拒绝。 -->
	<key>InputMethodConnectionName</key>
	<string>app.qingjian.inputmethod.Connection</string>
	<!-- 与 imk/controller/mod.rs 里 define_class! 的 #[name] 一致 -->
	<key>InputMethodServerControllerClass</key>
	<string>QingjianInputController</string>
	<key>InputMethodType</key>
	<string>Keyboard</string>

	<!-- Text Input Sources：系统「输入法」列表里的身份 -->
	<key>TISInputSourceID</key>
	<string>app.qingjian.inputmethod</string>
	<key>TISIntendedLanguage</key>
	<string>zh-Hans</string>
	<!-- 允许系统设置里打开「用 Caps Lock 在 ABC 与 Vakyu 之间切换」；缺省不开，Vakyu 自己的 Caps Lock 英文模式不变（#211） -->
	<key>TICapsLockLanguageSwitchCapable</key>
	<true/>
	<key>tsInputMethodIconFileKey</key>
	<string>vakyu-input-sourceTemplate.pdf</string>
	<!-- 系统菜单使用透明底轮廓，适应系统的明暗单色渲染。 -->
	<key>TISIconIsTemplate</key>
	<true/>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hans</string>
		<string>Latn</string>
	</array>

	<!-- 输入模式：系统登记、启用的是模式 app.qingjian.inputmethod.Hans，顶层 ID 是它的父项；
	显示名在 InfoPlist.strings 按模式 ID 给。约定见 docs/design/architecture.md「Info.plist 约定」 -->
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>app.qingjian.inputmethod.Hans</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>app.qingjian.inputmethod.Hans</string>
				<key>TISIntendedLanguage</key>
				<string>zh-Hans</string>
				<key>tsInputModeCharacterRepertoireKey</key>
				<array>
					<string>Hans</string>
				</array>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeMenuIconFileKey</key>
				<string>vakyu-input-sourceTemplate.pdf</string>
				<key>tsInputModeAlternateMenuIconFileKey</key>
				<string>vakyu-input-sourceTemplate.pdf</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>vakyu-input-source-baseline.pdf</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<key>tsInputModeScriptKey</key>
				<string>smSimpChinese</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>app.qingjian.inputmethod.Hans</string>
		</array>
	</dict>
</dict>
</plist>
